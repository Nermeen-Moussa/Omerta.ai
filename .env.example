# Copy to .env and fill in. Never commit .env.

# --- PostgreSQL ---
# Host port 15432 avoids clashing with native PostgreSQL installs (5432+).
DATABASE_URL=postgresql+asyncpg://omerta:omerta_dev_password@localhost:15432/omerta
TEST_DATABASE_URL=postgresql+asyncpg://omerta:omerta_dev_password@localhost:15432/omerta_test

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=omerta_dev_password
NEO4J_DATABASE=neo4j
# Namespace stamped on every projected node (dev/test data can coexist safely)
GRAPH_PROJECTION=dev

# --- LLM (provider-agnostic) ---
# 'fake' = deterministic no-network provider (default; no API key needed).
# Any OpenAI-compatible chat endpoint works via LLM_BASE_URL (openai, groq, ollama, vLLM).
LLM_PROVIDER=fake
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=             # optional override, e.g. local model server

# --- Vector store (RAG) ---
VECTOR_DB_URL=

# --- Risk subsystem ---
# 'mock' = deterministic rule-based (default, no artifact needed);
# 'ml' = trained LightGBM provider (requires: uv run python scripts/train_risk_model.py).
RISK_PROVIDER=mock

# --- Security (Phase 17) ---
# Leave empty in development (auth disabled). Set both to enable API-key auth.
API_KEY_ANALYST=
API_KEY_ADMIN=
# Requests per minute per key/IP; 0 disables rate limiting.
RATE_LIMIT_PER_MINUTE=0
RATE_LIMIT_BURST=

# --- Layer 3 (FraudGuard ML scoring + step-up) ---
# legacy = old inline rules; layer3 = XGBoost + IsolationForest + rules, typology, step-up/block.
RISK_ENGINE=legacy
# DEV ONLY: return the step-up OTP in the API response so the demo works without SMTP.
STEP_UP_DEV_ECHO=false

# --- Layer 4 (graph analytics & AML, runs after a transfer is confirmed) ---
LAYER4_ENABLED=false
LAYER4_NEO4J_INGEST=true
AML_WINDOW_HOURS=72
AML_THRESHOLD_EGP=50000     # lower to e.g. 1000 to demo smurfing with small transfers
LAYER3_USE_RECIPIENT_AGE=false   # true = feed recipient account age to the model (poorly calibrated for P2P)
