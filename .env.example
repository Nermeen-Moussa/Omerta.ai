# Copy to .env and fill in. Never commit .env.

# --- PostgreSQL ---
# Host port 15432 avoids clashing with native PostgreSQL installs (5432+).
DATABASE_URL=postgresql+asyncpg://omerta:omerta_dev_password@localhost:15432/omerta
TEST_DATABASE_URL=postgresql+asyncpg://omerta:omerta_dev_password@localhost:15432/omerta_test

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=omerta_dev_password
NEO4J_DATABASE=neo4j
# Namespace stamped on every projected node (dev/test data can coexist safely)
GRAPH_PROJECTION=dev

# --- LLM (provider-agnostic) ---
# 'fake' = deterministic no-network provider (default; no API key needed).
# Any OpenAI-compatible chat endpoint works via LLM_BASE_URL (openai, groq, ollama, vLLM).
LLM_PROVIDER=fake
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=             # optional override, e.g. local model server

# --- Vector store (RAG) ---
VECTOR_DB_URL=

# --- Risk subsystem ---
# 'mock' = deterministic rule-based (default, no artifact needed);
# 'ml' = trained LightGBM provider (requires: uv run python scripts/train_risk_model.py).
RISK_PROVIDER=mock
